<html>
<body>
    <h1>Items</h1>
    <table border="1" cellpadding="6">
        <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Notes</th>
        </tr>
        <% for (let item of items) { %>
            <tr>
                <td><%= item.id %></td>
                <td><%= item.name %></td>
                <td><%= item.notes %></td>
            </tr>
            3 / 6
        <% } %>
    </table>
</body>
</html>
